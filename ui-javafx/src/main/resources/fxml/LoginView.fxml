<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.javafx.controller.LoginController"
      alignment="CENTER"
      spacing="12"
      prefWidth="360" prefHeight="260">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Issue Tracking System"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="idField" promptText="ID" prefWidth="240"/>
    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="240"/>

    <Button text="Login"
            onAction="#onLogin"
            defaultButton="true"
            prefWidth="240"/>

    <Label fx:id="messageLabel"
           text=" "
           style="-fx-text-fill: #c0392b;"/>
</VBox>
