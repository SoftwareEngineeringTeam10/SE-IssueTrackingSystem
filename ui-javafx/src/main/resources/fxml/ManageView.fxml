<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.javafx.controller.ManageController"
            prefWidth="1024" prefHeight="720">

    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT"
              style="-fx-padding: 10; -fx-background-color: #f0f0f0;">

            <Label text="Issue Tracking System"
                   styleClass="label-header"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <ComboBox fx:id="projectCombo" promptText="Project"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel" text="User: -"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Menu" style="-fx-font-weight: bold;"/>
            <Button text="Issue List"
                    onAction="#onOpenList"
                    maxWidth="Infinity"/>
            <Button text="Register Issue"
                    fx:id="registerButton"
                    onAction="#onOpenRegister"
                    maxWidth="Infinity"/>
            <Button text="Recommend Assignee"
                    onAction="#onOpenRecommend"
                    visible="false" managed="false"
                    maxWidth="Infinity"/>
            <Button text="Manage" maxWidth="Infinity"/>
            <Button text="Statistics"
                    onAction="#onOpenStats"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 20;">

            <!-- 계정 관리 -->
            <Label text="계정 관리" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <TableView fx:id="accountTable" prefHeight="200">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn text="ID" prefWidth="160"/>
                    <TableColumn text="Name" prefWidth="200"/>
                    <TableColumn text="Role" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="newIdField" promptText="ID"/>
                <PasswordField fx:id="newPasswordField" promptText="Password"/>
                <TextField fx:id="newNameField" promptText="Name"/>
                <ComboBox fx:id="roleCombo" promptText="Role" prefWidth="110"/>
                <Button text="계정 추가" styleClass="button-primary" onAction="#onAddAccount" minWidth="90"/>
            </HBox>

            <Separator/>

            <!-- 프로젝트 관리 -->
            <Label text="프로젝트 관리"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <ListView fx:id="projectList" prefHeight="160"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="newProjectField"
                           promptText="Project name..."
                           HBox.hgrow="ALWAYS"/>
                <Button text="프로젝트 추가" styleClass="button-primary" onAction="#onAddProject"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-padding: 6 10 6 10; -fx-background-color: #eeeeee;">
            <Label fx:id="systemMessage" text=" "/>
        </HBox>
    </bottom>
</BorderPane>