<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.javafx.controller.IssueRegisterController"
            prefWidth="1024" prefHeight="720">

    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT"
              style="-fx-padding: 10; -fx-background-color: #f0f0f0;">

            <Label text="Issue Tracking System"
                   styleClass="label-header"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <ComboBox fx:id="projectCombo" promptText="Project"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel" text="User: -"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Menu" style="-fx-font-weight: bold;"/>
            <Button text="Issue List"
                    onAction="#onOpenList"
                    maxWidth="Infinity"/>
            <Button text="Register Issue" maxWidth="Infinity"/>
            <Button text="Recommend Assignee"
                    onAction="#onOpenRecommend"
                    visible="false" managed="false"
                    maxWidth="Infinity"/>
            <Button text="Manage"
                    fx:id="manageButton"
                    onAction="#onOpenManage"
                    maxWidth="Infinity"/>
            <Button text="Statistics"
                    onAction="#onOpenStats"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <GridPane hgap="10" vgap="10" style="-fx-padding: 20;">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="140"/>
                <ColumnConstraints prefWidth="400" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Project"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="projectField" editable="false"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Title *"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="titleField"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Priority"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="priorityCombo"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Description"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextArea fx:id="descriptionArea" prefRowCount="6"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Reporter"
                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="reporterField" editable="false"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Reported Date"
                   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="reportedDateField" editable="false"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <HBox spacing="10" alignment="CENTER_RIGHT"
                  GridPane.rowIndex="6" GridPane.columnIndex="1">

                <Button text="Register"
                        styleClass="button-primary"
                        onAction="#onRegister"
                        defaultButton="true"/>
                <Button text="Cancel"
                        onAction="#onCancel"
                        cancelButton="true"/>
            </HBox>
        </GridPane>
    </center>

    <bottom>
        <HBox style="-fx-padding: 6 10 6 10; -fx-background-color: #eeeeee;">
            <Label fx:id="systemMessage" text=" "/>
        </HBox>
    </bottom>
</BorderPane>
