<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.javafx.controller.StatsController"
            prefWidth="1024" prefHeight="720">

    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT"
              style="-fx-padding: 10; -fx-background-color: #f0f0f0;">

            <Label text="Issue Tracking System"
                   styleClass="label-header"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <ComboBox fx:id="projectCombo" promptText="Project"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel" text="User: -"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Menu" style="-fx-font-weight: bold;"/>
            <Button text="Issue List"
                    onAction="#onOpenList"
                    maxWidth="Infinity"/>
            <Button text="Register Issue"
                    onAction="#onOpenRegister"
                    maxWidth="Infinity"/>
            <Button text="Recommend Assignee"
                    visible="false" managed="false"
                    maxWidth="Infinity"/>
            <Button text="Manage"
                    fx:id="manageButton"
                    onAction="#onOpenManage"
                    maxWidth="Infinity"/>
            <Button text="Statistics" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <Label text="프로젝트 이슈 통계 분석"
                   styleClass="label-header"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <!-- 4개 스코어 카드 -->
            <HBox spacing="15" alignment="CENTER">
                <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e6ebf0; -fx-border-width: 2; -fx-padding: 12 15 12 15;"
                      prefWidth="160" alignment="CENTER">
                    <Label text="전체 이슈"
                           style="-fx-font-size: 12px; -fx-text-fill: #4682B4; -fx-font-weight: bold;"/>
                    <Label fx:id="totalLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e6ebf0; -fx-border-width: 2; -fx-padding: 12 15 12 15;"
                      prefWidth="160" alignment="CENTER">
                    <Label text="신규"
                           style="-fx-font-size: 12px; -fx-text-fill: #DC3545; -fx-font-weight: bold;"/>
                    <Label fx:id="newLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e6ebf0; -fx-border-width: 2; -fx-padding: 12 15 12 15;"
                      prefWidth="160" alignment="CENTER">
                    <Label text="해결됨"
                           style="-fx-font-size: 12px; -fx-text-fill: #28A745; -fx-font-weight: bold;"/>
                    <Label fx:id="fixedResolvedLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e6ebf0; -fx-border-width: 2; -fx-padding: 12 15 12 15;"
                      prefWidth="160" alignment="CENTER">
                    <Label text="종료"
                           style="-fx-font-size: 12px; -fx-text-fill: #6C757D; -fx-font-weight: bold;"/>
                    <Label fx:id="closedLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- BarChart 1: 일별 발생 추이 -->
            <BarChart fx:id="dailyChart" prefHeight="220" legendVisible="false">
                <xAxis>
                    <CategoryAxis label="날짜"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="이슈 건수"/>
                </yAxis>
            </BarChart>

            <!-- BarChart 2: 월별 발생 추이 -->
            <BarChart fx:id="monthlyChart" prefHeight="220" legendVisible="false">
                <xAxis>
                    <CategoryAxis label="월"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="이슈 건수"/>
                </yAxis>
            </BarChart>

            <!-- BarChart 3: 상태별 분포 -->
            <BarChart fx:id="statusChart" prefHeight="220" legendVisible="false">
                <xAxis>
                    <CategoryAxis label="상태"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="이슈 건수"/>
                </yAxis>
            </BarChart>
        </VBox>
    </center>

    <right>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Activity Log" style="-fx-font-weight: bold;"/>
            <ListView fx:id="activityLog" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <bottom>
        <HBox style="-fx-padding: 6 10 6 10; -fx-background-color: #eeeeee;">
            <Label fx:id="systemMessage" text=" "/>
        </HBox>
    </bottom>
</BorderPane>