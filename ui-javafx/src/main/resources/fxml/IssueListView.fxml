<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.javafx.controller.IssueListController"
            prefWidth="1024" prefHeight="720">

    <!-- Top: 타이틀 / 프로젝트 / 사용자 / 로그아웃 -->
    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT"
              style="-fx-padding: 10; -fx-background-color: #f0f0f0;">

            <Label text="Issue Tracking System"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <ComboBox fx:id="projectCombo" promptText="Project"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel" text="User: -"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>

    <!-- Left: 메뉴 -->
    <left>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="180">

            <Label text="Menu" style="-fx-font-weight: bold;"/>
            <Button text="Issue List" maxWidth="Infinity"/>
            <Button text="Register Issue"
                    onAction="#onOpenRegister"
                    maxWidth="Infinity"/>
            <Button text="Recommend Assignee"
                    onAction="#onRecommendAssignee"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Center: 검색 / 필터 / 테이블 / 액션 -->
    <center>
        <VBox spacing="8" style="-fx-padding: 10;">

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Search title..."
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="statusFilter" promptText="Status"/>
                <ComboBox fx:id="priorityFilter" promptText="Priority"/>
                <Button text="Search" onAction="#onSearch"/>
            </HBox>

            <TableView fx:id="issueTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="#" prefWidth="50"/>
                    <TableColumn text="Title" prefWidth="240"/>
                    <TableColumn text="Priority" prefWidth="80"/>
                    <TableColumn text="Status" prefWidth="100"/>
                    <TableColumn text="Reporter" prefWidth="100"/>
                    <TableColumn text="Assignee" prefWidth="100"/>
                    <TableColumn text="Reported Date" prefWidth="160"/>
                </columns>
            </TableView>

            <HBox spacing="8">
                <Button text="View Detail" onAction="#onOpenDetail"/>
            </HBox>
        </VBox>
    </center>

    <!-- Right: 활동 로그 -->
    <right>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Activity Log" style="-fx-font-weight: bold;"/>
            <ListView fx:id="activityLog" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <!-- Bottom: 시스템 메시지 -->
    <bottom>
        <HBox style="-fx-padding: 6 10 6 10; -fx-background-color: #eeeeee;">
            <Label fx:id="systemMessage" text=" "/>
        </HBox>
    </bottom>
</BorderPane>
