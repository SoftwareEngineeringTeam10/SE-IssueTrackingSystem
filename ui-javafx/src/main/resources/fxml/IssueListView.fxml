<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.javafx.controller.IssueListController"
            prefWidth="1024" prefHeight="720">

    <!-- Top: 타이틀 / 프로젝트 / 사용자 / 로그아웃 -->
    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT"
              style="-fx-padding: 10; -fx-background-color: #f0f0f0;">

            <Label text="Issue Tracking System"
                   styleClass="label-header"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <ComboBox fx:id="projectCombo" promptText="Project"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel" text="User: -"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>

    <!-- Left: 메뉴 -->
    <left>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Menu" style="-fx-font-weight: bold;"/>
            <Button text="Issue List" maxWidth="Infinity"/>
            <Button text="Register Issue"
                    fx:id="registerButton"
                    onAction="#onOpenRegister"
                    maxWidth="Infinity"/>
            <Button text="Recommend Assignee"
                    onAction="#onRecommendAssignee"
                    visible="false" managed="false"
                    maxWidth="Infinity"/>
            <Button text="Manage"
                    fx:id="manageButton"
                    onAction="#onOpenManage"
                    maxWidth="Infinity"/>
            <Button text="Statistics"
                    onAction="#onOpenStats"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Center: 검색 / 필터 / 테이블 / 액션 -->
    <center>
        <VBox spacing="8" style="-fx-padding: 10;">

            <VBox spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="Search title..."
                               HBox.hgrow="ALWAYS"/>
                    <Button text="Search" styleClass="button-primary" onAction="#onSearch" minWidth="80"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Status:" minWidth="55"/>
                    <ComboBox fx:id="statusFilter" minWidth="100"/>
                    <Label text="Priority:" minWidth="60"/>
                    <ComboBox fx:id="priorityFilter" minWidth="100"/>
                    <Label text="Assignee:" minWidth="65"/>
                    <ComboBox fx:id="assigneeFilter" minWidth="100"/>
                    <Label text="Reporter:" minWidth="65"/>
                    <ComboBox fx:id="reporterFilter" minWidth="100"/>
                </HBox>
            </VBox>

            <TableView fx:id="issueTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn text="#" prefWidth="50" minWidth="40"/>
                    <TableColumn text="Title" prefWidth="240" minWidth="160"/>
                    <TableColumn text="Priority" prefWidth="80" minWidth="70"/>
                    <TableColumn text="Status" prefWidth="100" minWidth="80"/>
                    <TableColumn text="Reporter" prefWidth="100" minWidth="80"/>
                    <TableColumn text="Assignee" prefWidth="100" minWidth="80"/>
                    <TableColumn text="Reported Date" prefWidth="190" minWidth="170"/>
                </columns>
            </TableView>

            <HBox spacing="8">
                <Button text="View Detail" styleClass="button-primary" onAction="#onOpenDetail"/>
            </HBox>
        </VBox>
    </center>

    <!-- Right: 활동 로그 -->
    <right>
        <VBox spacing="6"
              style="-fx-padding: 10; -fx-background-color: #fafafa;"
              prefWidth="220">

            <Label text="Activity Log" style="-fx-font-weight: bold;"/>
            <ListView fx:id="activityLog" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <!-- Bottom: 시스템 메시지 -->
    <bottom>
        <HBox style="-fx-padding: 6 10 6 10; -fx-background-color: #eeeeee;">
            <Label fx:id="systemMessage" text=" "/>
        </HBox>
    </bottom>
</BorderPane>
