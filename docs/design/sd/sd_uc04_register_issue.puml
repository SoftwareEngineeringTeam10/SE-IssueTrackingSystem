@startuml SD_UC04_RegisterIssue
title SD: UC04 이슈 등록 (createIssue)

actor Tester as t
participant ":IssueService" as svc
participant ":PermissionManager" as perm
participant ":AccountManager" as acc
participant "newIssue:Issue" as iss
participant ":IssueRepository" as repo

note over svc
  전제: currentUser, currentProject는
  세션 컨텍스트에서 이미 설정됨
end note

t -> svc : createIssue(title, description, priority)
activate svc

svc -> perm : canCreateIssue(currentUser)
activate perm
perm --> svc : true
deactivate perm

svc -> acc : getCurrentUser()
activate acc
acc --> svc : currentUser
deactivate acc

create iss
svc -> iss : <<create>>(currentUser.id, currentProject.projectId, title, description, priority)
activate iss
iss --> svc : newIssue
deactivate iss

svc -> repo : save(newIssue)
activate repo
repo --> svc : ok
deactivate repo

svc --> t : issueId
deactivate svc

@enduml