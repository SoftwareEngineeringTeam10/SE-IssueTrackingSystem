@startuml SD_UC04_RegisterIssue
title SD: UC04 이슈 등록 (createIssue)

actor Tester as t
participant ":IssueService" as svc
participant ":PermissionManager" as perm
participant ":AccountManager" as acc
participant "newIssue:Issue" as iss
participant ":IssueRepository" as repo

t -> svc : createIssue(title, description, priority)
activate svc

svc -> perm : canCreateIssue(currentUser)
activate perm
perm --> svc : true
deactivate perm

svc -> acc : getCurrentUser()
activate acc
acc --> svc : currentUser
deactivate acc

create iss
svc -> iss : <<create>>(title, description, priority)
activate iss
note right of iss
  자동 설정:
  - id (시스템 발급)
  - reporter := currentUser.id
  - reportedDate := now()
  - status := NEW
  - priority := MAJOR (미지정 시)
  - comments := []
end note
iss --> svc : newIssue
deactivate iss

svc -> repo : saveAll()
activate repo
repo --> svc : ok
deactivate repo

svc --> t : issueId
deactivate svc

@enduml