@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

title ITS Class Diagram

' --- Enums ---
enum Role {
    ADMIN
    PL
    DEV
    TESTER
}

enum Status {
    NEW
    ASSIGNED
    FIXED
    RESOLVED
    CLOSED
    REOPENED
}

enum Priority {
    BLOCKER
    CRITICAL
    MAJOR
    MINOR
}

' --- Entities ---
class Project {
    - projectId : String
    - name : String
    - createdDate : String
}

class Issue {
    + id: int
    + title: String
    + description: String
    + reporterId: String
    + fixerId: String
    + assigneeId: String
    + priority: Priority
    + status: Status
    + comments: List<Comment>
    --
    + addComment()
}

class Comment {
    + authorId: String
    + content: String
    + createdDate: String
}

class User {
    - id: String
    - password: String
    - name: String
    - role: Role
    --
    + getId()
    + getPassword()
    + getName()
    + getRole()
}

' --- Managers & Logic ---
class AccountManager {
    - users: List<User>
    - currentUser: User
    --
    + addUser()
    + login()
    + logout()
    + getCurrentUser()
}

class PermissionManager {
    --
    + canCreateIssue()
    + canAssignIssue()
    + canManageUsers()
}

class IssueService {
    --
    + getAllIssues()
    + createIssue()
    + getIssueById()
    + addComment()
}

' --- 🛠️ Repository 계층 분리 완료 ---
class UserRepository {
    --
    + findById()
    + save()
}

class ProjectRepository {
    --
    + findById()
    + findAll()
    + save()
}

class IssueRepository {
    --
    + findById()
    + findAll()
    + saveAll()
}

' --- Relationships ---

' 1. Project가 Issue를 포함
Project "1" *-- "*" Issue : contains

' 2. Issue가 Comment를 포함 (Composition)
Issue "1" *-- "*" Comment

' 3. User와 Issue의 관계
User "1" -- "*" Issue : reports
User "0..1" -- "*" Issue : assigned to
User "0..1" -- "*" Issue : fixes

' 4. User와 Comment의 관계
User "1" -- "*" Comment : writes

' 5. User와 Project와의 관계
User "*" -- "*" Project

' 6. 시스템 로직 및 저장소(Repository) 연관 관계
IssueService ..> PermissionManager : calls
IssueService --> Issue : manages
AccountManager --> User : manages
PermissionManager ..> User : checks

' 각 서비스와 매니저가 필요한 저장소를 각각 의존하도록 수정
IssueService ..> IssueRepository : uses
IssueService ..> ProjectRepository : uses
AccountManager ..> UserRepository : uses

@enduml