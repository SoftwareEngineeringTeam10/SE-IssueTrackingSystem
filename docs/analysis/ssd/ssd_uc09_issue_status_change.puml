@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Tester" as User
participant ":System" as System

title SSD: UC09 Issue Status Change

' ----------------------------------------------------
'  이슈 정보 조회
' ----------------------------------------------------
User -> System : getIssueDetail(issueId)
activate System
System --> User : issueData
deactivate System

' ----------------------------------------------------
' 상태 변경 요청
' ----------------------------------------------------
User -> System : requestStatusChange(newStatus, comment)
activate System

alt [Case 1: hasPermission AND newStatus != currentStatus]
    System --> User : updatedIssueInfo

else [Case 2: newStatus == currentStatus]
    System --> User : "No changes detected."

else [Case 3: Permission Denied]
    System --> User : "You do not have permission for this transition."
end

deactivate System

@enduml