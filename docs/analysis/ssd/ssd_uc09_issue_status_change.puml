@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Project Member" as User
participant ":System" as System

title SSD: UC09 Issue Status Change

' ----------------------------------------------------
' [사전 단계] 이슈 정보 조회
' ----------------------------------------------------
User -> System : getIssueDetail(issueId)
activate System
System --> User : displayIssueDetail(issueData, currentStatus)
deactivate System

' ----------------------------------------------------
' [핵심 단계] 상태 변경 요청
' ----------------------------------------------------
User -> System : requestStatusChange(newStatus, comment)
activate System

' alt 박스를 사용하여 성공과 실패 시나리오를 한꺼번에 표현
alt [newStatus != currentStatus AND hasPermission]
    ' 성공 케이스
    System --> User : notifySuccessWithUpdatedIssue(updatedIssueInfo)

else [newStatus == currentStatus]
    ' 예외 케이스 1: 변경 사항 없음
    System --> User : notifyError("No changes detected.")

else [Permission Denied]
    ' 예외 케이스 2: 권한 부족 (예: 개발자가 Closed로 바꾸려 할 때)
    System --> User : notifyError("You do not have permission for this transition.")
end

deactivate System

@enduml