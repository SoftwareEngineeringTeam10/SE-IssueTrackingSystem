@startuml
left to right direction
skinparam defaultFontName "Malgun Gothic"
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #555555
}
skinparam actor {
  BackgroundColor #FFFFFF
}

' ===== 액터 좌우 분리 =====

' 왼쪽: 시스템 관리/관리자
actor Admin
actor PL

rectangle "이슈관리 시스템" {

  ' --- 시스템 관리 영역 ---
  package "시스템 관리" {
    usecase "로그인" as UC01
    usecase "계정 추가" as UC02
    usecase "프로젝트 추가" as UC03
  }

  ' --- 이슈 라이프사이클 영역 ---
  package "이슈 라이프사이클" {
    usecase "이슈 등록" as UC04
    usecase "이슈 검색" as UC05
    usecase "이슈 상세 조회" as UC06
    usecase "코멘트 추가" as UC07
    usecase "담당자 배정" as UC08
    usecase "이슈 상태 변경" as UC09
  }

  ' --- 분석/추천 영역 ---
  package "분석 / 추천" {
    usecase "이슈 통계 조회" as UC10
    usecase "Assignee 추천 확인" as UC11
  }
}

' 오른쪽: 일반 사용자
actor Developer
actor Tester

' ===== 관계 =====

' 로그인 (전원)
Admin --> UC01
PL --> UC01
UC01 <-- Developer
UC01 <-- Tester

' Admin 전용
Admin --> UC02
Admin --> UC03

' 이슈 등록 (PL/Dev/Tester)
PL --> UC04
UC04 <-- Developer
UC04 <-- Tester

' 검색/조회 (전원)
Admin --> UC05
PL --> UC05
UC05 <-- Developer
UC05 <-- Tester

Admin --> UC06
PL --> UC06
UC06 <-- Developer
UC06 <-- Tester

' 코멘트 (PL/Dev/Tester)
PL --> UC07
UC07 <-- Developer
UC07 <-- Tester

' PL 전용
PL --> UC08
PL --> UC11

' 상태 변경 (PL/Dev/Tester)
PL --> UC09
UC09 <-- Developer
UC09 <-- Tester

' 통계 (Admin/PL)
Admin --> UC10
PL --> UC10

' include/extend는 5/11 회의에서 함께 결정

@enduml